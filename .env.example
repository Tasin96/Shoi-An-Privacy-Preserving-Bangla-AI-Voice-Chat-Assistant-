# Shoi Environment Configuration
APP_NAME=Shoi
DEBUG=True
SECRET_KEY=shoi-secret-key-change-in-production-random-uuid-64738291
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=90

# Database (SQLite default for zero-config dev, PostgreSQL supported)
DATABASE_URL=sqlite:///./shoi.db

# LLM Configuration (Options: gemini, openai, groq, mock)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# TTS & ASR Configuration
TTS_ENGINE=edge-tts
BANGLA_VOICE=bn-BD-NabanitaNeural
WHISPER_MODEL=base
